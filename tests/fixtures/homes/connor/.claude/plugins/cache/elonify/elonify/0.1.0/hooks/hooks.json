{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/elonify-hook.mjs\" --token SECRET_ARG_SHOULD_NOT_LEAK",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "elonify-critic",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/elonify-hook.mjs\" --token SECRET_ARG_SHOULD_NOT_LEAK",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/elonify-hook.mjs\" --token SECRET_ARG_SHOULD_NOT_LEAK",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
